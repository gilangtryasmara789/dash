rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gilangtryasmara789@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVehicle(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.noLambung is string && data.noLambung.size() <= 64 &&
             data.noPolisi is string && data.noPolisi.size() <= 64 &&
             data.tipeKendaraan is string && data.tipeKendaraan.size() <= 128 &&
             data.department is string && data.department.size() <= 128 &&
             data.statusOperasi is string && data.statusOperasi.size() <= 64 &&
             data.lastPmDate is string && data.lastPmDate.size() <= 32 &&
             data.nextPmDueDate is string && data.nextPmDueDate.size() <= 32 &&
             data.pmStatus is string && data.pmStatus.size() <= 32 &&
             (!('driver' in data) || (data.driver is string && data.driver.size() <= 128)) &&
             (!('lokasi' in data) || (data.lokasi is string && data.lokasi.size() <= 128)) &&
             (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 2000)) &&
             (!('currentKmHm' in data) || data.currentKmHm is number);
    }

    // Vehicles Collection (Fleet Assets & PM Records)
    match /vehicles/{vehicleId} {
      // Public read so mobile and desktop dashboards can display real-time telemetry instantly
      allow read: if true;
      allow create: if isSignedIn() && isValidId(vehicleId) && isValidVehicle(request.resource.data);
      allow update: if isSignedIn() && isValidId(vehicleId) && isValidVehicle(request.resource.data);
      allow delete: if isAdmin() && isValidId(vehicleId);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
